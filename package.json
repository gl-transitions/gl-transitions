{
  "name": "gl-transitions-repository",
  "private": true,
  "description": "Development tooling of the gl-transitions repository. The published packages are in packages/.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "lint": "node scripts/checks/lint-transitions.mjs",
    "pretest": "pnpm -r --filter '!gl-transitions' --if-present run build",
    "test": "node --test \"**/*.test.mjs\"",
    "validate": "node scripts/checks/validate-transition.mjs",
    "build": "pnpm --filter gl-transitions run build",
    "render:references": "node scripts/rendering/render-references.mjs",
    "render:preview": "node scripts/rendering/render-preview.mjs",
    "build:sksl": "node scripts/targets/build-sksl.mjs",
    "build:agent-docs": "node scripts/agents/build-agent-docs.mjs --out packages/gl-transitions/dist",
    "build:crate": "node scripts/rust-crate/build-crate.mjs",
    "build:swift": "node scripts/swift-package/build-swift-package.mjs",
    "build:android": "node scripts/android-library/build-android-library.mjs",
    "build:glsl3": "node scripts/targets/build-glsl3.mjs",
    "build:wgsl-msl": "node scripts/targets/build-wgsl-msl.mjs",
    "build:compatibility": "node scripts/targets/build-compatibility.mjs",
    "format": "prettier --write \"scripts/**/*.mjs\" \"packages/*/{src,test,scripts}/**/*.{ts,tsx,mjs}\" \"examples/*/{*.{ts,tsx,js},src/**/*.{ts,tsx},scripts/**/*.mjs}\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"packages/*/{src,test,scripts}/**/*.{ts,tsx,mjs}\" \"examples/*/{*.{ts,tsx,js},src/**/*.{ts,tsx},scripts/**/*.mjs}\"",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/rust-crate/sync-version.mjs && pnpm install --lockfile-only"
  },
  "dependencies": {
    "canvaskit-wasm": "0.42.0",
    "pngjs": "^7.0.0"
  },
  "optionalDependencies": {
    "gl": "^8.0.0",
    "webgpu": "0.6.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10"
  }
}
