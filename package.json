{
  "name": "gl-transitions-repository",
  "private": true,
  "description": "Development tooling of the gl-transitions repository. The published package is built from scripts/npm-package/skeleton.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/checks/lint-transitions.mjs",
    "pretest": "npm run build --workspaces --if-present",
    "test": "node --test",
    "validate": "node scripts/checks/validate-transition.mjs",
    "build": "./scripts/npm-package/build.sh",
    "render:references": "node scripts/rendering/render-references.mjs",
    "render:preview": "node scripts/rendering/render-preview.mjs",
    "build:sksl": "node scripts/targets/build-sksl.mjs",
    "build:agent-docs": "node scripts/agents/build-agent-docs.mjs --out release",
    "format": "prettier --write \"scripts/**/*.mjs\" \"packages/*/{src,test,scripts}/**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"packages/*/{src,test,scripts}/**/*.{ts,tsx,mjs}\""
  },
  "dependencies": {
    "canvaskit-wasm": "0.42.0",
    "pngjs": "^7.0.0"
  },
  "optionalDependencies": {
    "gl": "^8.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "overrides": {
    "tar": "^7.5.21",
    "node-gyp": "^11",
    "react-native-skia-android": "file:../../../packages/react-native-skia/test/native-binaries-stub",
    "react-native-skia-apple-ios": "file:../../../packages/react-native-skia/test/native-binaries-stub",
    "react-native-skia-apple-macos": "file:../../../packages/react-native-skia/test/native-binaries-stub",
    "react-native-skia-apple-tvos": "file:../../../packages/react-native-skia/test/native-binaries-stub"
  }
}
